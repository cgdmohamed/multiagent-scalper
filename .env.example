# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=REPLACE_WITH_RANDOM_SECRET

# Optional: enables advisory shadow agents; never live execution
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
AI_MAX_REVIEWS_PER_RUN=20
# RSS headlines are untrusted informational inputs. Minimum 60 seconds.
NEWS_POLL_SECONDS=180
